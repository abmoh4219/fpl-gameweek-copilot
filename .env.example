# Armband — environment template
#
# Placeholders only: this file is committed. Copy it to `.env` for local work.
# Real values live in exactly one place each:
#   jobs/   -> GitHub Secrets
#   web/    -> Vercel environment variables
#   agent/  -> Hugging Face Space secrets
# The Gemini key and the Telegram channel live inside Make, not here.

# --- jobs/ ------------------------------------------------------------------

# Postgres connection for the sync jobs (Supabase > Connect > Session pooler).
# Cloud value in GitHub Secrets ONLY. Leave unset locally: jobs default to the
# local stack and refuse a cloud database outside GitHub Actions.
SUPABASE_DB_URL=

# football-data.org token — Champions League dates for the congestion flag.
FOOTBALL_DATA_API_TOKEN=

# Your FPL team id (the number after /entry/ in your Points page address),
# used by `pnpm sample` to record your squad as a test fixture.
FPL_ENTRY_ID=

# Make scenario webhooks, and the shared secret Make's first filter checks.
MAKE_WEBHOOK_EVENTS_URL=
MAKE_WEBHOOK_PREVIEW_URL=
MAKE_WEBHOOK_SECRET=

# Failure alerts go straight to Telegram from code, bypassing Make.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# true = fetch and detect, write nothing.
DRY_RUN=false

# --- web/ -------------------------------------------------------------------

# Supabase project URL and publishable key (sb_publishable_...). Public by
# design: they only reach the read-only `api` schema and RLS-guarded rows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The deployed site's address, for share images and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The agent service (Hugging Face Space) and the secret it checks.
# Generate the secret with `openssl rand -hex 32`; same value in the Space.
AGENT_URL=http://127.0.0.1:7860
AGENT_SHARED_SECRET=

# --- agent/ -----------------------------------------------------------------

# Anthropic key. A Hugging Face Space secret ONLY — never in Vercel, never in
# a file, never in git.
ANTHROPIC_API_KEY=

# The agent reads the same public views as the website.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: defaults to claude-haiku-5-5.
# AGENT_MODEL=

# --- supabase/.env (local Google sign-in) ------------------------------------
# A separate, gitignored file read by `pnpm db:start`. In production these two
# values are entered in the Supabase dashboard instead (docs/deploy.md §4b).
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
