# =============================================================================
# FPL Gameweek Copilot — environment template
# =============================================================================
# PLACEHOLDERS ONLY. Never put a real value in this file — it is committed.
#
# Where real values actually live:
#   GitHub Secrets  -> everything used by jobs/ in GitHub Actions
#   Vercel env vars -> everything used by web/
#   Make.com        -> GEMINI_API_KEY and the Telegram connection
#   .env (local)    -> your own copy, gitignored
#   .env.local      -> local-only overrides, loaded after .env, gitignored
# =============================================================================

# --- FPL public API (no key required) ----------------------------------------

# Your FPL team ID, from the URL of your points page:
# fantasy.premierleague.com/entry/<THIS_NUMBER>/event/1
# source: FPL website | used by: jobs/ (squad report), web/ (/my-team default)
FPL_ENTRY_ID=0000000

# --- football-data.org --------------------------------------------------------

# Free API token. Used ONLY for Champions League fixture dates (competition
# code CL / id 2001) to compute the fixture congestion flag. 10 req/min.
# source: football-data.org account dashboard | used by: jobs/
FOOTBALL_DATA_API_TOKEN=your_football_data_token

# --- Supabase -----------------------------------------------------------------

# Project URL, e.g. https://abcdefghijkl.supabase.co
# source: Supabase dashboard > Project Settings > API | used by: jobs/
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key. FULL database access, bypasses RLS.
# NEVER expose to the browser and never prefix it with NEXT_PUBLIC_.
# source: Supabase dashboard > Project Settings > API | used by: jobs/ only
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Direct Postgres connection string. Jobs write through THIS, not the Data API:
# only the `api` schema is exposed over HTTP, so even the service role cannot
# reach `core` through PostgREST (ADR-0005).
# Leave unset for local development — jobs default to the local stack at
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
# source: Supabase dashboard > Connect > Session pooler | used by: jobs/
SUPABASE_DB_URL=postgresql://postgres:your_db_password@your-host:5432/postgres

# Same project URL, exposed to the browser.
# source: Supabase dashboard > Project Settings > API | used by: web/
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key. Safe in the browser; reads are limited by RLS to the
# read-only views the web app is allowed to see.
# source: Supabase dashboard > Project Settings > API | used by: web/
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- Make.com -----------------------------------------------------------------

# Webhook URL of Scenario 1 (event alerts). ONE POST per run, batched payload.
# source: Make > Scenario 1 > Custom webhook module | used by: jobs/
MAKE_WEBHOOK_EVENTS_URL=https://hook.make.com/your_events_webhook_id

# Webhook URL of Scenario 2 (pre-deadline preview).
# source: Make > Scenario 2 > Custom webhook module | used by: jobs/
MAKE_WEBHOOK_PREVIEW_URL=https://hook.make.com/your_preview_webhook_id

# Shared secret you invent yourself. jobs/ sends it as a request header and
# Make filters on it, so a stranger who finds the webhook URL cannot fire it.
# source: generate your own random string | used by: jobs/ (sent) + Make (checked)
MAKE_WEBHOOK_SECRET=generate_a_long_random_string

# --- Telegram -----------------------------------------------------------------

# Bot token from @BotFather.
# source: Telegram @BotFather | used by: jobs/ (failure alerts) + web/ (bot replies)
TELEGRAM_BOT_TOKEN=123456789:your_bot_token

# Your own chat ID — where sync failure alerts are sent directly from code,
# bypassing Make so alerts still arrive when Make is the thing that broke.
# source: message your bot, then read getUpdates | used by: jobs/
TELEGRAM_ALERT_CHAT_ID=000000000

# Public channel the reports are published to, e.g. @fplgameweekcopilot.
# source: your Telegram channel | used by: Make (listed here for a complete setup)
TELEGRAM_CHANNEL_ID=@your_channel

# Secret you invent, passed to the Telegram setWebhook call. The Next.js route
# verifies the X-Telegram-Bot-Api-Secret-Token header against it.
# source: generate your own random string | used by: web/ (/api/telegram)
TELEGRAM_WEBHOOK_SECRET=generate_a_long_random_string

# --- Gemini -------------------------------------------------------------------

# Gemini API key. STORED IN MAKE, not used by this repo — the preview text is
# generated inside Scenario 2. Listed so the setup checklist is complete.
# source: Google AI Studio | used by: Make (Scenario 2)
GEMINI_API_KEY=stored_in_make_not_here

# --- App config ---------------------------------------------------------------

# Public base URL of the deployed site, used for share images and links.
# source: your Vercel deployment | used by: web/
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FPL deadlines are UK time. GitHub Actions cron is UTC — see CLAUDE.md §4.
# source: fixed | used by: jobs/, web/
TZ=Europe/London

# debug | info | warn | error
# source: fixed | used by: jobs/
LOG_LEVEL=info

# true = run the pipeline but send no webhooks and no Telegram messages.
# source: fixed | used by: jobs/
DRY_RUN=false
