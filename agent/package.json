{
  "name": "@fpl/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Copilot agent service: Claude Agent SDK + read-only FPL tools, run in a container (docs/agent-plan.md).",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../.env --env-file-if-exists=../.env.local src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build:space": "node scripts/build-space.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@fpl/shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "esbuild": "^0.28.2"
  }
}
