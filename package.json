{
  "name": "fpl-gameweek-copilot",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.21.0",
  "description": "Football data automation pipeline for Fantasy Premier League managers.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "sample": "pnpm --filter @fpl/jobs run sample",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "load:samples": "pnpm --filter @fpl/jobs run load:samples",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "job:price": "pnpm --filter @fpl/jobs run job:price",
    "job:daily": "pnpm --filter @fpl/jobs run job:daily",
    "job:preview": "pnpm --filter @fpl/jobs run job:preview",
    "backfill:gw": "pnpm --filter @fpl/jobs run backfill:gw",
    "make:sample": "pnpm --filter @fpl/jobs run make:sample"
  },
  "devDependencies": {
    "supabase": "^2.117.0"
  }
}
