    "job:daily": "tsx --env-file-if-exists=../.env --env-file-if-exists=../.env.local src/jobs/daily-sync.ts",
    "job:preview": "tsx --env-file-if-exists=../.env --env-file-if-exists=../.env.local src/jobs/preview.ts",
